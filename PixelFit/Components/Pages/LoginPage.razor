@page "/"
@page "/login"

@using PixelFit.Service
@inject AuthService AuthService
@inject NavigationManager Navigation


<div class="login-container">

    <!-- PixelFit branding -->
    <div class="brand">

        <!-- PixelFit logo -->
        <img src="images/PixelFitLogo.png"
             class="brand-logo"
             alt="PixelFit Logo" />

        <h1>PIXELFIT</h1>

        <p>TRÆN. UDVIKL. GENTAG.</p>

    </div>


    <!-- Login formular -->
    <div class="login-form">

        <!-- Email -->
        <div class="input-group">

            <label>Email</label>

            <input type="email"
                   @bind="email"
                   placeholder="navn@email.dk" />

        </div>


        <!-- Adgangskode -->
        <div class="input-group">

            <label>Adgangskode</label>

            <input type="password"
                   @bind="password"
                   placeholder="Indtast din adgangskode" />

        </div>


        <!-- Glemt adgangskode -->
        <div class="forgot-password">

            <a href="/forgot-password">
                Glemt adgangskode?
            </a>

        </div>


        <!-- Login knap -->
        <button class="login-button"
                @onclick="Login">

            LOG IND

        </button>


        <!-- Viser fejlbesked hvis login fejler -->
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="message">@message</p>
        }


        <!-- Opdeling mellem login og opret bruger -->
        <div class="divider">

            <span></span>

            <p>ELLER</p>

            <span></span>

        </div>


        <!-- Link til opret bruger -->
        <p class="register-text">

            Har du ikke en konto?

            <a href="/opret-bruger">
                Opret konto
            </a>

        </p>

    </div>

</div>


@code {

    // Gemmer det brugeren skriver i email-feltet
    private string email = "";

    // Gemmer det brugeren skriver i password-feltet
    private string password = "";

    // Bruges til at vise fejlbeskeder på siden
    private string message = "";


    // Bliver kørt når brugeren trykker LOG IND
    private async Task Login()
    {
        // Kontrollerer at begge felter er udfyldt
        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            message = "Udfyld email og adgangskode.";
            return;
        }


        // Sender email og adgangskode til AuthService
        // AuthService sender derefter oplysningerne til API'et
        var token = await AuthService.LoginAsync(
            email,
            password
        );


        // Hvis API'et ikke returnerer et JWT-token,
        // er login mislykket
        if (string.IsNullOrWhiteSpace(token))
        {
            message = "Forkert email eller adgangskode.";
            return;
        }


        // Gemmer JWT-token sikkert på enheden
        // Tokenet bruges senere til beskyttede API-kald
        await SecureStorage.Default.SetAsync(
            "auth_token",
            token
        );


        // Sender brugeren videre efter korrekt login
        Navigation.NavigateTo("/home");
    }
}