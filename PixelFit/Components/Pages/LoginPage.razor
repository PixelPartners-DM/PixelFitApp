@page "/"
@page "/login"

@using PixelFit.Service
@inject AuthService AuthService
@inject NavigationManager Navigation


<!-- Hele login-siden.
     Denne wrapper bruges blandt andet til baggrundsbilledet. -->
<div class="login-page">

    <!-- Container til selve login-indholdet -->
    <div class="login-container">


        <!-- PixelFit branding -->
        <div class="brand">

            <img src="images/PixelFitLogo.png"
                 class="brand-logo"
                 alt="PixelFit Logo" />

            <h1>PIXELFIT</h1>

            <p>TRÆN. UDVIKL. GENTAG.</p>

        </div>


        <!-- Login formular -->
        <div class="login-form">


            <!-- Email -->
            <div class="input-group">

                <label>Email</label>

                <input type="email"
                       @bind="email"
                       placeholder="navn@email.dk" />

            </div>


            <!-- Adgangskode -->
            <div class="input-group">

                <label>Adgangskode</label>

                <input type="password"
                       @bind="password"
                       placeholder="Indtast din adgangskode" />

            </div>


            <!-- Glemt adgangskode -->
            <div class="forgot-password">

                <a href="/forgot-password">
                    Glemt adgangskode?
                </a>

            </div>


            <!-- Login knap -->
            <button class="login-button"
                    @onclick="Login">

                LOG IND

            </button>


            <!-- Viser fejl eller statusbesked -->
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p class="message">
                    @message
                </p>
            }


            <!-- Opdeling -->
            <div class="divider">

                <span></span>

                <p>ELLER</p>

                <span></span>

            </div>


            <!-- Link til opret bruger -->
            <p class="register-text">

                Har du ikke en konto?

                <a href="/opret-bruger">
                    Opret konto
                </a>

            </p>

        </div>

    </div>

</div>


@code {

    // Gemmer brugerens email
    private string email = "";

    // Gemmer brugerens adgangskode
    private string password = "";

    // Bruges til fejl og statusbeskeder
    private string message = "";


    // Bliver kørt når brugeren trykker LOG IND
    private async Task Login()
    {
        // Fjerner tidligere beskeder
        message = "";


        // Tjekker om email og adgangskode er udfyldt
        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            message = "Udfyld email og adgangskode.";
            return;
        }


        // Viser at login er i gang
        message = "Logger ind...";


        try
        {
            // Sender email og adgangskode til AuthService.
            // Hvis login lykkes får vi JWT-token tilbage.
            var token = await AuthService.LoginAsync(
                email,
                password
            );


            // DEBUG:
            // Viser JWT-token i Visual Studio Output.
            // Skal fjernes igen når vi er færdige med at teste.
            Console.WriteLine($"JWT TOKEN: {token}");


            // Hvis vi ikke får et token tilbage,
            // er login mislykket.
            if (string.IsNullOrWhiteSpace(token))
            {
                message = "Forkert email eller adgangskode.";
                return;
            }


            // Gemmer JWT-token sikkert på enheden.
            // Tokenet skal senere bruges når vi kalder
            // beskyttede endpoints i API'et.
            await SecureStorage.Default.SetAsync(
                "auth_token",
                token
            );


            // Sender den loggede bruger videre
            // til profilsiden.
            Navigation.NavigateTo("/my-profil");
        }
        catch (Exception)
        {
            // Brugeren får en almindelig fejlbesked.
            // Vi viser ikke tekniske systemoplysninger.
            message = "Der opstod en fejl under login. Prøv igen.";
        }
    }
}