@page "/my-profil"

@inject NavigationManager Navigation

<div class="profil-side">

    <div class="profil-container">

        <!-- PixelFit branding -->
        <div class="profil-brand">

            <img src="images/PixelFitLogo.png"
                 class="profil-logo"
                 alt="PixelFit Logo" />

            <span>PIXELFIT</span>

        </div>


        <!-- Velkomstområde -->
        <div class="profil-overskrift">

            <p class="overtekst">MIN PROFIL</p>

            <h1>Velkommen tilbage</h1>

            <p>
                Hold styr på din træning, kost og udvikling.
            </p>

        </div>


        <!-- Hurtig oversigt -->
        <div class="hurtig-oversigt">

            <!-- Dagens træning -->
            <div class="oversigt-kort">

                <span class="kort-ikon">🏋️</span>

                <p>DAGENS TRÆNING</p>

                <h2>Ingen træning</h2>

                <span class="kort-info">
                    Ingen planlagt endnu
                </span>

            </div>


            <!-- Kalorier -->
            <div class="oversigt-kort">

                <span class="kort-ikon">🔥</span>

                <p>KALORIER I DAG</p>

                <h2>0 kcal</h2>

                <span class="kort-info">
                    Intet registreret
                </span>

            </div>

        </div>


        <!-- Træningssektion -->
        <div class="menu-sektion">

            <p class="sektion-titel">
                TRÆNING
            </p>


            <button class="menu-kort"
                    @onclick="GaaTilTraeningsprogrammer">

                <div class="menu-venstre">

                    <span class="menu-ikon">🏋️</span>

                    <div>
                        <h3>Træningsprogrammer</h3>

                        <p>
                            Opret og administrer dine programmer
                        </p>
                    </div>

                </div>

                <span class="pil">›</span>

            </button>

        </div>


        <!-- Kost og udvikling -->
        <div class="menu-sektion">

            <p class="sektion-titel">
                KOST & UDVIKLING
            </p>


            <!-- Kalorier -->
            <button class="menu-kort"
                    @onclick="GaaTilKalorier">

                <div class="menu-venstre">

                    <span class="menu-ikon">🔥</span>

                    <div>
                        <h3>Kalorier</h3>

                        <p>
                            Beregn dit daglige kaloriebehov
                        </p>
                    </div>

                </div>

                <span class="pil">›</span>

            </button>


            <!-- Kost -->
            <button class="menu-kort"
                    @onclick="GaaTilKost">

                <div class="menu-venstre">

                    <span class="menu-ikon">🥗</span>

                    <div>
                        <h3>Kost</h3>

                        <p>
                            Registrer dine måltider
                        </p>
                    </div>

                </div>

                <span class="pil">›</span>

            </button>


            <!-- Vægt -->
            <button class="menu-kort"
                    @onclick="GaaTilVaegt">

                <div class="menu-venstre">

                    <span class="menu-ikon">⚖️</span>

                    <div>
                        <h3>Vægt</h3>

                        <p>
                            Følg din vægtudvikling
                        </p>
                    </div>

                </div>

                <span class="pil">›</span>

            </button>


            <!-- Statistik -->
            <button class="menu-kort"
                    @onclick="GaaTilStatistik">

                <div class="menu-venstre">

                    <span class="menu-ikon">📊</span>

                    <div>
                        <h3>Statistik</h3>

                        <p>
                            Se din udvikling over tid
                        </p>
                    </div>

                </div>

                <span class="pil">›</span>

            </button>

        </div>


        <!-- Log ud -->
        <button class="logout-knap"
                @onclick="LogUd">

            LOG UD

        </button>

    </div>

</div>


@code {

    // Sender brugeren til træningsprogrammer
    private void GaaTilTraeningsprogrammer()
    {
        Navigation.NavigateTo("/traeningsprogrammer");
    }


    // Sender brugeren til kalorier
    private void GaaTilKalorier()
    {
        Navigation.NavigateTo("/kalorier");
    }


    // Sender brugeren til kost
    private void GaaTilKost()
    {
        Navigation.NavigateTo("/kost");
    }


    // Sender brugeren til vægt
    private void GaaTilVaegt()
    {
        Navigation.NavigateTo("/vaegt");
    }


    // Sender brugeren til statistik
    private void GaaTilStatistik()
    {
        Navigation.NavigateTo("/statistik");
    }


    // Logger brugeren ud
    private void LogUd()
    {
        // Fjerner JWT-tokenet fra SecureStorage
        SecureStorage.Default.Remove("auth_token");

        // Sender brugeren tilbage til login
        Navigation.NavigateTo("/login");
    }
}