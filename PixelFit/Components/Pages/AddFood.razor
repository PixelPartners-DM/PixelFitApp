@page "/kost/tilfoej/{MealType}"

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using PixelFit.Models.Food
@using PixelFit.Models.Nutrition

@inject HttpClient Http
@inject NavigationManager Navigation


<div class="add-food-page">

    <div class="add-food-overlay"></div>

    <div class="add-food-content @(isLeaving ? "page-leaving" : "")">

        <!-- TOPBAR -->
        <div class="add-food-topbar">

            <button class="back-button"
                    @onclick="GoBack">
                ‹
            </button>

            <div class="brand-header">

                <img src="images/PixelFitLogo.png"
                     alt="PixelFit Logo"
                     class="brand-logo" />

                <span>PIXELFIT</span>

            </div>

        </div>


        <!-- HEADER -->
        <div class="add-food-header">

            <p class="eyebrow">
                TILFØJ MAD
            </p>

            <h1>
                @MealType
            </h1>

            <p class="subtitle">
                Tilføj en madvare og dens næringsindhold.
            </p>

        </div>


        <!-- FORM CARD -->
        <div class="add-food-card">

            <!-- NAVN -->
            <div class="form-group">

                <label>
                    MADVARE
                </label>

                <input type="text"
                       placeholder="Fx Havregryn"
                       @bind="name" />

            </div>


            <!-- KALORIER -->
            <div class="form-group">

                <label>
                    KALORIER
                </label>

                <div class="input-wrapper">

                    <input type="number"
                           min="0"
                           @bind="calories" />

                    <span>
                        kcal
                    </span>

                </div>

            </div>


            <!-- MAKROER -->
            <div class="macro-input-grid">

                <div class="form-group">

                    <label>
                        PROTEIN
                    </label>

                    <div class="input-wrapper">

                        <input type="number"
                               step="0.1"
                               min="0"
                               @bind="protein" />

                        <span>
                            g
                        </span>

                    </div>

                </div>


                <div class="form-group">

                    <label>
                        CARBS
                    </label>

                    <div class="input-wrapper">

                        <input type="number"
                               step="0.1"
                               min="0"
                               @bind="carbs" />

                        <span>
                            g
                        </span>

                    </div>

                </div>


                <div class="form-group">

                    <label>
                        FEDT
                    </label>

                    <div class="input-wrapper">

                        <input type="number"
                               step="0.1"
                               min="0"
                               @bind="fat" />

                        <span>
                            g
                        </span>

                    </div>

                </div>


                <div class="form-group">

                    <label>
                        FIBRE
                    </label>

                    <div class="input-wrapper">

                        <input type="number"
                               step="0.1"
                               min="0"
                               @bind="fiber" />

                        <span>
                            g
                        </span>

                    </div>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="form-message">
                    @message
                </div>
            }


            <button class="save-food-button"
                    disabled="@saving"
                    @onclick="SaveFood">

                @if (saving)
                {
                    <span>
                        GEMMER...
                    </span>
                }
                else
                {
                    <span>
                        GEM MADVARE
                    </span>
                }

            </button>

        </div>

    </div>

</div>


@code
{
    [Parameter]
    public string MealType { get; set; } =
        string.Empty;


    private string name =
        string.Empty;

    private int calories = 0;

    private double protein = 0;

    private double carbs = 0;

    private double fat = 0;

    private double fiber = 0;


    private bool saving = false;

    private bool isLeaving = false;

    private string message = "";


    private async Task SaveFood()
    {
        if (saving)
        {
            return;
        }


        message = "";


        if (string.IsNullOrWhiteSpace(name))
        {
            message =
                "Skriv navnet på madvaren.";

            return;
        }


        if (calories < 0 ||
            protein < 0 ||
            carbs < 0 ||
            fat < 0 ||
            fiber < 0)
        {
            message =
                "Værdier kan ikke være negative.";

            return;
        }


        try
        {
            saving = true;


            var token =
                await SecureStorage.Default.GetAsync(
                    "auth_token"
                );


            if (string.IsNullOrWhiteSpace(token))
            {
                Navigation.NavigateTo(
                    "/login"
                );

                return;
            }


            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    token
                );


            var request =
                new CreateMealRequest
                {
                    MealType =
                        MealType,

                    Date =
                        DateTime.Now,

                    Items =
                        new List<CreateFoodItemRequest>
                        {
                            new CreateFoodItemRequest
                            {
                                Name =
                                    name,

                                Calories =
                                    calories,

                                Protein =
                                    protein,

                                Carbs =
                                    carbs,

                                Fat =
                                    fat,

                                Fiber =
                                    fiber
                            }
                        }
                };


            var response =
                await Http.PostAsJsonAsync(
                    "api/Nutrition/meals",
                    request
                );


            if (!response.IsSuccessStatusCode)
            {
                var error =
                    await response.Content
                        .ReadAsStringAsync();


                Console.WriteLine(error);


                message =
                    "Madvaren kunne ikke gemmes.";

                return;
            }


            await LeavePage();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            message =
                "Der opstod en fejl under gemning.";
        }
        finally
        {
            saving = false;
        }
    }


    private async Task GoBack()
    {
        if (isLeaving)
        {
            return;
        }


        await LeavePage();
    }


    private async Task LeavePage()
    {
        isLeaving = true;

        await Task.Delay(300);

        Navigation.NavigateTo(
            "/kost"
        );
    }
}