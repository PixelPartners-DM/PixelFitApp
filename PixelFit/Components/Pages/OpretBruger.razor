@page "/opret-bruger"

@using PixelFit.Service
@inject AuthService AuthService
@inject NavigationManager Navigation


<div class="opret-side">

    <div class="opret-container">

        <!-- PixelFit branding -->
        <div class="logo-omraade">

            <img src="images/PixelFitLogo.png"
                 alt="PixelFit Logo" />

            <span>PIXELFIT</span>

        </div>


        <!-- Overskrift -->
        <div class="overskrift">

            <h1>Opret bruger</h1>

            <p>
                Opret din konto og kom i gang med PixelFit.
            </p>

        </div>


        <!-- Formular -->
        <div class="opret-form">

            <!-- Email -->
            <div class="input-gruppe">

                <label>Email</label>

                <input type="email"
                       @bind="email"
                       placeholder="navn@email.dk" />

            </div>


            <!-- Adgangskode -->
            <div class="input-gruppe">

                <label>Adgangskode</label>

                <input type="password"
                       @bind="password"
                       placeholder="Indtast adgangskode" />

            </div>


            <!-- Gentag adgangskode -->
            <div class="input-gruppe">

                <label>Gentag adgangskode</label>

                <input type="password"
                       @bind="gentagPassword"
                       placeholder="Gentag adgangskode" />

            </div>


            <!-- Opret bruger knap -->
            <button class="opret-knap"
                    @onclick="Opret">

                OPRET BRUGER

            </button>


            <!-- Viser fejl eller statusbesked -->
            @if (!string.IsNullOrWhiteSpace(besked))
            {
                <p class="besked">@besked</p>
            }

        </div>


        <!-- Link tilbage til login -->
        <p class="login-link">

            Har du allerede en konto?

            <a href="/login">
                Log ind
            </a>

        </p>

    </div>


    <!-- Succes popup -->
    @if (visSucces)
    {
        <div class="popup-overlay">

            <div class="popup-boks">

                <h2>Bruger oprettet!</h2>

                <p>
                    Din PixelFit-konto er nu klar.
                    Du kan logge ind med din email og adgangskode.
                </p>

                <button @onclick="GaaTilLogin">
                    GÅ TIL LOGIN
                </button>

            </div>

        </div>
    }

</div>


@code {

    // Gemmer brugerens email
    private string email = "";

    // Gemmer brugerens adgangskode
    private string password = "";

    // Gemmer den gentagede adgangskode
    private string gentagPassword = "";

    // Bruges til fejl og statusbeskeder
    private string besked = "";

    // Bestemmer om succes-popup skal vises
    private bool visSucces = false;


    // Bliver kørt når brugeren trykker på OPRET BRUGER
    private async Task Opret()
    {
        // Fjerner en tidligere besked
        besked = "";


        // Tjekker om alle felter er udfyldt
        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password) ||
            string.IsNullOrWhiteSpace(gentagPassword))
        {
            besked = "Udfyld alle felter.";
            return;
        }


        // Tjekker at adgangskoden er mindst 6 tegn
        if (password.Length < 6)
        {
            besked = "Adgangskoden skal være mindst 6 tegn.";
            return;
        }


        // Tjekker om adgangskoderne matcher
        if (password != gentagPassword)
        {
            besked = "Adgangskoderne er ikke ens.";
            return;
        }


        // Fortæller brugeren at oprettelsen er i gang
        besked = "Vent venligst...";


        try
        {
            // Sender email og adgangskode til API'et
            var success = await AuthService.RegisterAsync(
                email,
                password
            );


            // Hvis API'et afviser oprettelsen
            if (!success)
            {
                besked = "Brugeren kunne ikke oprettes. Prøv igen.";
                return;
            }


            // Fjerner statusbeskeden
            besked = "";

            // Viser succes-popup
            visSucces = true;
        }
        catch (Exception)
        {
            // Viser ikke tekniske fejl til brugeren
            besked = "Der opstod en fejl. Prøv igen senere.";
        }
    }


    // Sender brugeren til login-siden
    private void GaaTilLogin()
    {
        Navigation.NavigateTo("/login");
    }
}