@page "/training-day/{TrainingDayId:int}/muscle-group/{MuscleGroupId:int}"

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using PixelFit.Models.Training

@inject HttpClient Http
@inject NavigationManager Navigation


<div class="muscle-exercises-page">

    <div class="muscle-exercises-overlay"></div>

    <div class="muscle-exercises-content @(isLeaving ? "page-leaving" : "")">

        <!-- TOPBAR -->
        <div class="muscle-topbar">

            <button class="back-button"
                    @onclick="GoBack">
                ‹
            </button>

            <div class="brand-header">

                <img src="images/PixelFitLogo.png"
                     alt="PixelFit Logo"
                     class="brand-logo" />

                <span>PIXELFIT</span>

            </div>

        </div>


        <!-- HEADER -->
        <div class="muscle-header">

            <p class="eyebrow">
                VÆLG ØVELSER
            </p>

            <h1>
                @muscleGroupName
            </h1>

            <p class="subtitle">
                Vælg de øvelser du vil have med på denne træningsdag.
            </p>

        </div>


        @if (loading)
        {
            <div class="loader-wrapper">

                <div class="loader"></div>

                <p>
                    Henter øvelser...
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="status-message">

                <p>
                    @message
                </p>

            </div>
        }
        else if (exercises.Count == 0)
        {
            <div class="empty-state">

                <div class="empty-icon">
                    🏋️
                </div>

                <h2>
                    Ingen øvelser
                </h2>

                <p>
                    Der findes endnu ingen øvelser til denne muskelgruppe.
                </p>

            </div>
        }
        else
        {
            <div class="section-title">
                ØVELSER
            </div>


            <div class="exercise-grid">

                @foreach (var exercise in exercises)
                {
                    var selected =
                    selectedExerciseIds.Contains(
                    exercise.Id
                    );


                    <button class="exercise-choice-card @(selected ? "selected" : "")"
                            disabled="@isChangingExercise"
                            @onclick="() => ToggleExercise(exercise)">


                        <!-- BILLEDE -->
                        <div class="image-wrapper">

                            <img src="@exercise.ImageUrl"
                                 alt="@exercise.Name"
                                 class="exercise-image" />


                            @if (selected)
                            {
                                <div class="selected-overlay">
                                    ✓
                                </div>
                            }

                        </div>


                        <!-- INFO -->
                        <div class="exercise-text">

                            <h2>
                                @exercise.Name
                            </h2>


                            @if (!string.IsNullOrWhiteSpace(
                                                exercise.MuscleGroupName))
                            {
                                <p>
                                    @exercise.MuscleGroupName
                                </p>
                            }

                        </div>


                        <!-- ACTION -->
                        <div class="exercise-action">

                            @if (selected)
                            {
                                <span class="selected-text">
                                    ✓ TILFØJET
                                </span>
                            }
                            else
                            {
                                <span class="add-text">
                                    + TILFØJ
                                </span>
                            }

                        </div>

                    </button>
                }

            </div>
        }


        @if (!string.IsNullOrWhiteSpace(actionMessage))
        {
            <div class="action-message">
                @actionMessage
            </div>
        }

    </div>

</div>


@code
{

    [Parameter]
    public int TrainingDayId { get; set; }


    [Parameter]
    public int MuscleGroupId { get; set; }




    private List<ExerciseResponse> exercises = new();


    private HashSet<int> selectedExerciseIds = new();


    private string muscleGroupName =
        "Muskelgruppe";




    private bool loading = true;

    private bool isLeaving = false;

    private bool isChangingExercise = false;


    private string message = "";

    private string actionMessage = "";


    protected override async Task OnParametersSetAsync()
    {
        await LoadPage();
    }


    private async Task LoadPage()
    {
        loading = true;

        message = "";

        actionMessage = "";


        try
        {
            // JWT-token
            var token =
                await SecureStorage.Default.GetAsync(
                    "auth_token"
                );


            if (string.IsNullOrWhiteSpace(token))
            {
                Navigation.NavigateTo(
                    "/login"
                );

                return;
            }


            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    token
                );


            var muscleGroups =
                await Http.GetFromJsonAsync<
                    List<MuscleGroupResponse>>(
                        "api/MuscleGroups"
                    );


            var muscleGroup =
                muscleGroups?
                    .FirstOrDefault(
                        x =>
                            x.Id ==
                            MuscleGroupId
                    );


            if (muscleGroup == null)
            {
                message =
                    "Muskelgruppen blev ikke fundet.";

                return;
            }


            muscleGroupName =
                muscleGroup.Name;



            var exerciseResult =
                await Http.GetFromJsonAsync<
                    List<ExerciseResponse>>(
                        $"api/Exercises/muscle-group/{MuscleGroupId}"
                    );


            exercises =
                exerciseResult ??
                new List<ExerciseResponse>();



            var selectedExercises =
                await Http.GetFromJsonAsync<
                    List<TrainingDayExerciseResponse>>(
                        $"api/TrainingDayExercises/day/{TrainingDayId}"
                    );


            selectedExerciseIds =
                selectedExercises?
                    .Select(
                        x => x.ExerciseId
                    )
                    .ToHashSet()
                ??
                new HashSet<int>();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            message =
                "Kunne ikke hente øvelserne.";
        }
        finally
        {
            loading = false;
        }
    }


    private async Task ToggleExercise(
        ExerciseResponse exercise)
    {
        if (isChangingExercise)
        {
            return;
        }


        try
        {
            isChangingExercise = true;

            actionMessage = "";


            // JWT-token
            var token =
                await SecureStorage.Default.GetAsync(
                    "auth_token"
                );


            if (string.IsNullOrWhiteSpace(token))
            {
                Navigation.NavigateTo(
                    "/login"
                );

                return;
            }


            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    token
                );



            if (selectedExerciseIds.Contains(
                exercise.Id))
            {
                var selectedExercises =
                    await Http.GetFromJsonAsync<
                        List<TrainingDayExerciseResponse>>(
                            $"api/TrainingDayExercises/day/{TrainingDayId}"
                        );


                var selectedExercise =
                    selectedExercises?
                        .FirstOrDefault(
                            x =>
                                x.ExerciseId ==
                                exercise.Id
                        );


                if (selectedExercise == null)
                {
                    actionMessage =
                        "Øvelsen kunne ikke findes.";

                    return;
                }


                var deleteResponse =
                    await Http.DeleteAsync(
                        $"api/TrainingDayExercises/{selectedExercise.Id}"
                    );


                if (!deleteResponse.IsSuccessStatusCode)
                {
                    var error =
                        await deleteResponse.Content
                            .ReadAsStringAsync();


                    Console.WriteLine(error);


                    actionMessage =
                        "Øvelsen kunne ikke fjernes.";

                    return;
                }


                selectedExerciseIds.Remove(
                    exercise.Id
                );


                actionMessage =
                    $"{exercise.Name} blev fjernet.";


                return;
            }



            var existingExercises =
                await Http.GetFromJsonAsync<
                    List<TrainingDayExerciseResponse>>(
                        $"api/TrainingDayExercises/day/{TrainingDayId}"
                    );


            var nextOrder =
                existingExercises == null ||
                existingExercises.Count == 0
                    ? 1
                    : existingExercises.Max(
                        x => x.Order
                    ) + 1;


            var response =
                await Http.PostAsJsonAsync(
                    "api/TrainingDayExercises",

                    new
                    {
                        TrainingDayId =
                            TrainingDayId,

                        ExerciseId =
                            exercise.Id,

                        RestBetweenExercises =
                            120,

                        Order =
                            nextOrder
                    }
                );


            if (!response.IsSuccessStatusCode)
            {
                var error =
                    await response.Content
                        .ReadAsStringAsync();


                Console.WriteLine(error);


                actionMessage =
                    "Øvelsen kunne ikke tilføjes.";

                return;
            }


            selectedExerciseIds.Add(
                exercise.Id
            );


            actionMessage =
                $"{exercise.Name} blev tilføjet ✓";
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            actionMessage =
                "Der opstod en fejl. Prøv igen.";
        }
        finally
        {
            isChangingExercise = false;
        }
    }




    private async Task GoBack()
    {
        if (isLeaving)
        {
            return;
        }


        isLeaving = true;


        await Task.Delay(300);


        Navigation.NavigateTo(
            $"/training-day/{TrainingDayId}"
        );
    }
}