@page "/my-profil"

@using PixelFit.Models.Training
@using PixelFit.Models.Nutrition
@using PixelFit.Models.Food
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Net

@inject HttpClient Http
@inject NavigationManager Navigation


<div class="profil-side">

    <div class="profil-container">
         

        <div class="profil-brand">

            <img src="images/PixelFitLogo.png"
                 class="profil-logo"
                 alt="PixelFit Logo" />

            <span>PIXELFIT</span>

        </div>



        <div class="profil-overskrift">

            <p class="overtekst">
                MIN PROFIL
            </p>

            <h1>
                Velkommen tilbage
            </h1>

            <p>
                Hold styr på din træning, kost og udvikling.
            </p>

        </div>



        <div class="today-section">

            @if (loadingTraining)
            {
                <div class="today-workout-card loading">

                    <div class="today-top">

                        <div class="today-heading">

                            <span class="today-icon">
                                🏋️
                            </span>

                            <span class="today-label">
                                DAGENS TRÆNING
                            </span>

                        </div>

                    </div>


                    <div class="today-main">

                        <h2>
                            Henter...
                        </h2>

                        <p>
                            Finder dagens træning
                        </p>

                    </div>

                </div>
            }
            else if (todayTrainingDay != null)
            {
                <button class="today-workout-card"
                        @onclick="OpenTodayTraining">

                    <div class="today-top">

                        <div class="today-heading">

                            <span class="today-icon">
                                🏋️
                            </span>

                            <span class="today-label">
                                DAGENS TRÆNING
                            </span>

                        </div>

                        <span class="today-arrow">
                            ›
                        </span>

                    </div>


                    <div class="today-main">

                        <h2>
                            @GetDisplayDayName(
                            todayTrainingDay.DayName
                                                )
                    </h2>


                    <p class="today-workout-info">

                        @if (todayExercises.Count == 0)
                            {
                                <span>
                                    Ingen øvelser valgt endnu
                                </span>
                            }
                            else
                            {
                                <span>
                                    @(todayExercises.Count == 1
                                                                ? "1 øvelse"
                                                                : $"{todayExercises.Count} øvelser")
                        </span>


                        @if (todayEstimatedMinutes > 0)
                                {
                                    <span class="today-info-dot">
                                        •
                                    </span>

                                    <span>
                                        ca. @todayEstimatedMinutes min
                                    </span>
                                }
                            }

                        </p>

                    </div>


                    <div class="today-start">

                        <span class="today-start-icon">
                            ▶
                        </span>

                        START TRÆNING

                    </div>

                </button>
            }
            else
            {
                <div class="today-workout-card rest-day">

                    <div class="today-top">

                        <div class="today-heading">

                            <span class="today-icon">
                                😴
                            </span>

                            <span class="today-label">
                                DAGENS TRÆNING
                            </span>

                        </div>

                    </div>


                    <div class="today-main">

                        <h2>
                            Hviledag
                        </h2>

                        <p>
                            Ingen træning planlagt i dag
                        </p>

                    </div>

                </div>
            }

        </div>



        <button class="calorie-summary-card"
                @onclick="GaaTilKalorier">

            <!-- TOP -->
            <div class="calorie-summary-top">

                <div class="calorie-left">

                    <span class="calorie-icon">
                        🔥
                    </span>

                    <div>

                        <span class="calorie-label">
                            KALORIER I DAG
                        </span>


                        @if (loadingCalories || loadingNutrition)
                        {
                            <p>
                                Henter dagens kost...
                            </p>
                        }
                        else if (hasCalorieGoal)
                        {
                            <p>

                                @if (todayNutrition.TotalCalories > 0)
                                {
                                    <span>
                                        @todayNutrition.RemainingCalories kcal tilbage
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        @dailyCalorieGoal kcal mål
                                    </span>
                                }

                            </p>
                        }
                        else
                        {
                            <p>
                                Intet kaloriemål valgt endnu
                            </p>
                        }

                    </div>

                </div>


                <div class="calorie-right">

                    @if (loadingCalories || loadingNutrition)
                    {
                        <strong>
                            ...
                        </strong>
                    }
                    else
                    {
                        <strong>
                            @todayNutrition.TotalCalories
                        </strong>


                        @if (hasCalorieGoal)
                        {
                            <span>
                                / @dailyCalorieGoal kcal
                            </span>
                        }
                        else
                        {
                            <span>
                                kcal
                            </span>
                        }
                    }


                    <span class="calorie-arrow">
                        ›
                    </span>

                </div>

            </div>


            @if (!loadingNutrition)
            {
                <div class="profile-macro-grid">

                    <!-- PROTEIN -->
                    <div class="profile-macro-item">

                        <span class="profile-macro-label">
                            PROTEIN
                        </span>

                        <strong>
                            @todayNutrition.Protein.ToString("0.#") g
                        </strong>

                    </div>


                    <!-- CARBS -->
                    <div class="profile-macro-item">

                        <span class="profile-macro-label">
                            CARBS
                        </span>

                        <strong>
                            @todayNutrition.Carbs.ToString("0.#") g
                        </strong>

                    </div>


                    <!-- FEDT -->
                    <div class="profile-macro-item">

                        <span class="profile-macro-label">
                            FEDT
                        </span>

                        <strong>
                            @todayNutrition.Fat.ToString("0.#") g
                        </strong>

                    </div>


                    <!-- FIBRE -->
                    <div class="profile-macro-item">

                        <span class="profile-macro-label">
                            FIBRE
                        </span>

                        <strong>
                            @todayNutrition.Fiber.ToString("0.#") g
                        </strong>

                    </div>

                </div>
            }

        </button>



        <div class="menu-sektion training-section">

            <p class="sektion-titel">
                TRÆNING
            </p>


            <button class="menu-kort"
                    @onclick="GaaTilTraeningsprogrammer">

                <div class="menu-venstre">

                    <span class="menu-ikon">
                        🏋️
                    </span>

                    <div>

                        <h3>
                            Træningsprogrammer
                        </h3>

                        <p>
                            Opret og administrer dine programmer
                        </p>

                    </div>

                </div>

                <span class="pil">
                    ›
                </span>

            </button>

        </div>

        

        <div class="menu-sektion development-section">

            <p class="sektion-titel">
                KOST & UDVIKLING
            </p>


            <!-- KALORIER -->

            <button class="menu-kort"
                    @onclick="GaaTilKalorier">

                <div class="menu-venstre">

                    <span class="menu-ikon">
                        🔥
                    </span>

                    <div>

                        <h3>
                            Kalorier
                        </h3>

                        <p>
                            Beregn dit daglige kaloriebehov
                        </p>

                    </div>

                </div>

                <span class="pil">
                    ›
                </span>

            </button>


            <!-- KOST -->

            <button class="menu-kort"
                    @onclick="GaaTilKost">

                <div class="menu-venstre">

                    <span class="menu-ikon">
                        🥗
                    </span>

                    <div>

                        <h3>
                            Kost
                        </h3>

                        <p>
                            Registrer dine måltider
                        </p>

                    </div>

                </div>

                <span class="pil">
                    ›
                </span>

            </button>


            <!-- VÆGT -->

            <button class="menu-kort"
                    @onclick="GaaTilVaegt">

                <div class="menu-venstre">

                    <span class="menu-ikon">
                        ⚖️
                    </span>

                    <div>

                        <h3>
                            Vægt
                        </h3>

                        <p>
                            Følg din vægtudvikling
                        </p>

                    </div>

                </div>

                <span class="pil">
                    ›
                </span>

            </button>


            <!-- STATISTIK -->

            <button class="menu-kort"
                    @onclick="GaaTilStatistik">

                <div class="menu-venstre">

                    <span class="menu-ikon">
                        📊
                    </span>

                    <div>

                        <h3>
                            Statistik
                        </h3>

                        <p>
                            Se din udvikling over tid
                        </p>

                    </div>

                </div>

                <span class="pil">
                    ›
                </span>

            </button>

        </div>



        <button class="logout-knap"
                @onclick="LogUd">

            LOG UD

        </button>

    </div>

</div>


@code
{

    private bool loadingTraining = true;

    private TrainingDayResponse? todayTrainingDay;

    private List<TrainingDayExerciseResponse> todayExercises =
        new();

    private int todayEstimatedMinutes = 0;



    private bool loadingCalories = true;

    private bool hasCalorieGoal = false;

    private int dailyCalorieGoal = 0;



    private bool loadingNutrition = true;

    private DailyNutritionResponse todayNutrition =
        new();



    protected override async Task OnInitializedAsync()
    {
        await LoadTodayTraining();

        await LoadCalorieProfile();

        await LoadTodayNutrition();
    }



    private async Task<string?> GetToken()
    {
        var token =
            await SecureStorage.Default.GetAsync(
                "auth_token"
            );


        if (string.IsNullOrWhiteSpace(token))
        {
            Navigation.NavigateTo(
                "/login"
            );

            return null;
        }


        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue(
                "Bearer",
                token
            );


        return token;
    }



    private async Task LoadTodayTraining()
    {
        loadingTraining = true;

        todayEstimatedMinutes = 0;


        try
        {
            var token =
                await GetToken();


            if (token == null)
            {
                return;
            }


            var todayName =
                GetApiDayName(
                    DateTime.Now.DayOfWeek
                );


            var programs =
                await Http.GetFromJsonAsync<
                    List<TrainingProgramResponse>>(
                        "api/TrainingPrograms"
                    )
                ??
                new List<TrainingProgramResponse>();


            todayTrainingDay =
                null;


            todayExercises =
                new List<TrainingDayExerciseResponse>();


            todayEstimatedMinutes =
                0;


            foreach (var program in programs)
            {
                var days =
                    await Http.GetFromJsonAsync<
                        List<TrainingDayResponse>>(
                            $"api/TrainingDays/program/{program.Id}"
                        )
                    ??
                    new List<TrainingDayResponse>();


                var matchingDay =
                    days.FirstOrDefault(
                        day =>
                            string.Equals(
                                day.DayName,
                                todayName,
                                StringComparison.OrdinalIgnoreCase
                            )
                    );


                if (matchingDay == null)
                {
                    continue;
                }


                todayTrainingDay =
                    matchingDay;


                todayExercises =
                    await Http.GetFromJsonAsync<
                        List<TrainingDayExerciseResponse>>(
                            $"api/TrainingDayExercises/day/{matchingDay.Id}"
                        )
                    ??
                    new List<TrainingDayExerciseResponse>();


                todayEstimatedMinutes =
                    await CalculateEstimatedWorkoutTime();


                break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Kunne ikke hente dagens træning: {ex.Message}"
            );


            todayTrainingDay =
                null;


            todayExercises =
                new List<TrainingDayExerciseResponse>();


            todayEstimatedMinutes =
                0;
        }
        finally
        {
            loadingTraining = false;
        }
    }



    private async Task<int> CalculateEstimatedWorkoutTime()
    {
        if (todayExercises.Count == 0)
        {
            return 0;
        }


        const int secondsPerSet = 45;

        const int secondsBetweenExercises = 60;


        var totalSeconds = 0;

        var exercisesWithSets = 0;


        foreach (var exercise in todayExercises)
        {
            try
            {
                var sets =
                    await Http.GetFromJsonAsync<
                        List<ExerciseSetResponse>>(
                            $"api/ExerciseSets/exercise/{exercise.Id}"
                        )
                    ??
                    new List<ExerciseSetResponse>();


                if (sets.Count == 0)
                {
                    continue;
                }


                exercisesWithSets++;


                totalSeconds +=
                    sets.Count *
                    secondsPerSet;


                for (var i = 0;
                     i < sets.Count - 1;
                     i++)
                {
                    totalSeconds +=
                        sets[i].RestBetweenSets;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    $"Kunne ikke beregne tid for øvelse {exercise.Id}: {ex.Message}"
                );
            }
        }


        if (exercisesWithSets > 1)
        {
            totalSeconds +=
                (exercisesWithSets - 1) *
                secondsBetweenExercises;
        }


        return (int)Math.Ceiling(
            totalSeconds / 60.0
        );
    }



    private async Task LoadCalorieProfile()
    {
        loadingCalories = true;

        hasCalorieGoal = false;

        dailyCalorieGoal = 0;


        try
        {
            var token =
                await GetToken();


            if (token == null)
            {
                return;
            }


            var response =
                await Http.GetAsync(
                    "api/UserProfile/me"
                );


            if (response.StatusCode ==
                HttpStatusCode.NotFound)
            {
                return;
            }


            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine(
                    $"Kunne ikke hente kalorieprofil. Status: {response.StatusCode}"
                );

                return;
            }


            var profile =
                await response.Content
                    .ReadFromJsonAsync<
                        UserProfileResponse>();


            if (profile == null)
            {
                return;
            }


            dailyCalorieGoal =
                profile.DailyCalorieGoal;


            hasCalorieGoal =
                dailyCalorieGoal > 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Kunne ikke hente kalorieprofil: {ex.Message}"
            );
        }
        finally
        {
            loadingCalories = false;
        }
    }



    private async Task LoadTodayNutrition()
    {
        loadingNutrition = true;


        try
        {
            var token =
                await GetToken();


            if (token == null)
            {
                return;
            }


            var result =
                await Http.GetFromJsonAsync<
                    DailyNutritionResponse>(
                        "api/Nutrition/today"
                    );


            todayNutrition =
                result ??
                new DailyNutritionResponse();


            // Hvis Nutrition endpointet allerede sender
            // kaloriemålet bruger vi det som fallback.
            if (dailyCalorieGoal <= 0 &&
                todayNutrition.DailyCalorieGoal > 0)
            {
                dailyCalorieGoal =
                    todayNutrition.DailyCalorieGoal;

                hasCalorieGoal =
                    true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Kunne ikke hente dagens kost: {ex.Message}"
            );


            todayNutrition =
                new DailyNutritionResponse();
        }
        finally
        {
            loadingNutrition = false;
        }
    }



    private string GetApiDayName(
        DayOfWeek day)
    {
        return day switch
        {
            DayOfWeek.Monday =>
                "Mandag",

            DayOfWeek.Tuesday =>
                "Tirsdag",

            DayOfWeek.Wednesday =>
                "Onsdag",

            DayOfWeek.Thursday =>
                "Torsdag",

            DayOfWeek.Friday =>
                "Fredag",

            DayOfWeek.Saturday =>
                "Loerdag",

            DayOfWeek.Sunday =>
                "Soendag",

            _ =>
                ""
        };
    }



    private string GetDisplayDayName(
        string dayName)
    {
        return dayName switch
        {
            "Loerdag" =>
                "Lørdag",

            "Soendag" =>
                "Søndag",

            _ =>
                dayName
        };
    }



    private void OpenTodayTraining()
    {
        if (todayTrainingDay == null)
        {
            return;
        }


        Navigation.NavigateTo(
            $"/workout/{todayTrainingDay.Id}"
        );
    }



    private void GaaTilTraeningsprogrammer()
    {
        Navigation.NavigateTo(
            "/traeningsprogrammer"
        );
    }


    private void GaaTilKalorier()
    {
        Navigation.NavigateTo(
            "/kalorier"
        );
    }


    private void GaaTilKost()
    {
        Navigation.NavigateTo(
            "/kost"
        );
    }


    private void GaaTilVaegt()
    {
        Navigation.NavigateTo(
            "/vaegt"
        );
    }


    private void GaaTilStatistik()
    {
        Navigation.NavigateTo(
            "/statistik"
        );
    }



    private void LogUd()
    {
        SecureStorage.Default.Remove(
            "auth_token"
        );


        Navigation.NavigateTo(
            "/login"
        );
    }
}